{
  "name": "vishesh-jewellers-json-app",
  "version": "1.5.0",
  "private": true,
  "author": "Tech Aditya",
  "main": "electron-main.js",
  "description": "KaratDesk by Tech Aditya — jewellery invoicing and inventory with encrypted local storage",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:icons": "node scripts/build-desktop-icons.js",
    "check:packaged": "node scripts/check-packaged-runtime.js",
    "check:packaged:database": "node scripts/check-packaged-database.js",
    "check:database-key": "electron scripts/check-database-key.js",
    "check:setup-recovery": "electron scripts/check-setup-recovery.js",
    "license:issuer": "node scripts/license-issuer.js",
    "build:frontend": "node scripts/build-offline-assets.js && npm run typecheck && vite build",
    "dev:frontend": "vite build --watch",
    "prepackage:desktop": "npm run build:frontend",
    "prepackage:windows": "npm run build:frontend",
    "prepackage:all": "npm run build:frontend",
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "test:database": "node --test test/database*.test.js",
    "database:prepare": "node scripts/prepare-database.js",
    "database:verify": "node scripts/verify-database.js",
    "benchmark:database": "node scripts/benchmark-database.js",
    "pretest": "npm run build:frontend",
    "start": "node server.js",
    "start:database": "node scripts/start-migrated.js",
    "dev:database": "nodemon --config nodemon.database.json",
    "dev": "nodemon --config nodemon.json server.js",
    "watch": "node --watch server.js",
    "desktop": "electron .",
    "package:desktop": "electron-builder --mac dmg",
    "prepackage:mac:test": "npm run build:frontend",
    "package:mac:test": "electron-builder --config scripts/mac-test-config.js --mac dmg --x64 --publish never",
    "prepackage:mac:universal": "npm run build:frontend",
    "package:mac:universal": "electron-builder --mac dmg --universal",
    "package:windows": "electron-builder --win nsis",
    "package:all": "electron-builder --mac dmg --win nsis"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "43.8.3",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "build": {
    "copyright": "Copyright © 2026 Tech Aditya",
    "npmRebuild": false,
    "afterPack": "scripts/verify-packaged-layout.js",
    "appId": "com.visheshjewellers.billing",
    "productName": "KaratDesk",
    "files": [
      "electron-main.js",
      "scripts/setup.html",
      "scripts/setup-preload.js",
      "scripts/workspace-preload.js",
      "scripts/recovery.html",
      "scripts/recovery-ui.js",
      "scripts/recovery-preload.js",
      "server.js",
      "lib/**/*",
      "source/**/*",
      "public/**/*",
      "assets/**/*",
      "!node_modules/pdf2json/dist/*.map",
      "!node_modules/pdf2json/dist/pdfparser.js",
      "!node_modules/pdf2json/dist/*.d.*",
      "package.json"
    ],
    "asarUnpack": [
      "package.json",
      "node_modules/**/*",
      "server.js",
      "lib/**/*",
      "source/**/*",
      "public/**/*",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/desktop/icon.icns",
      "mergeASARs": false,
      "x64ArchFiles": "**/better-sqlite3-multiple-ciphers/prebuilds/darwin-*.node",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/desktop/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "fastify": "5.12.7",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "pdf2json": "3.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
