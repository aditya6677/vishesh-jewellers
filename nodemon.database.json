{
  "watch": ["frontend", "source", "lib", "assets", "server.js", "scripts/start-migrated.js", "scripts/build-offline-assets.js"],
  "ext": "js,mjs,cjs,ts,tsx,json,html,css,svg,png",
  "ignore": ["data/**", "backups/**", "public/**", "dist/**", "release/**", "node_modules/**", "experiments/**", "**/*.db*", "**/*.app-lock*"],
  "delay": "1500",
  "signal": "SIGTERM",
  "env": { "LOCAL_DATABASE_PORT": "56685" },
  "exec": "npm run build:frontend && node scripts/start-migrated.js"
}
